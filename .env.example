# Скопировать в .env и заполнить. Сам .env в git не попадает.

PORT=3000

# Telegram: токен от @BotFather, secret — длинная случайная строка,
# её же передать в setWebhook и сверять с заголовком X-Telegram-Bot-Api-Secret-Token
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Postgres из docker-compose, порт проброшен только на localhost
DATABASE_URL=postgres://omni:omni@127.0.0.1:5432/omni

# RabbitMQ оттуда же
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
RABBITMQ_EXCHANGE=messages
RABBITMQ_PREFETCH=10
RABBITMQ_MAX_RETRIES=5
